# LogAA — puller (defect 수집기, https :8000)
# user 모드 설치: ~/.config/systemd/user/ 에 복사 (deploy/README.md 참조)
# 전제: puller/certs/server.{key,crt} 배치, config.yaml 의 OS 의존 설정
# (chromium_path 등) 이 서버 환경에 맞게 조정되어 있어야 한다 (puller 설계서 §9-9).

[Unit]
Description=LogAA puller (defect collector, https port 8000)

[Service]
WorkingDirectory=%h/LogAA/puller/ui/api
ExecStart=%h/LogAA/.venv/bin/python main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
